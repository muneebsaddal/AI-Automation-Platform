# LLM Provider — set USE_OPENAI=true to switch from Ollama to OpenAI
USE_OPENAI=false

# OpenAI (used when USE_OPENAI=true)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Ollama (used when USE_OPENAI=false)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Redis
REDIS_URL=redis://localhost:6379

# App
APP_HOST=0.0.0.0
APP_PORT=8000
